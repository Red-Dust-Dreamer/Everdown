{
  "name": "abyss-idle",
  "version": "2.0.0",
  "private": true,
  "description": "深渊挂机 — 终端放置刷宝游戏(TS 同构核心:Web / Node CLI 共用)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cli": "node --experimental-strip-types src/cli.ts",
    "sim": "node --experimental-strip-types src/sim.ts",
    "demo": "node --experimental-strip-types src/sim.ts --demo",
    "parity": "bash scripts/parity.sh",
    "test": "node --experimental-strip-types src/tests/regression.ts"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "^4.146.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "canvas-confetti": "^1.9.4"
  }
}
